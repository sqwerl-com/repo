{
  "author": "Sqwerl Technologies, LLC",
  "description": "JavaScript logger that wraps Winston logging package so that log messages can be prefixed with optional class/module and method/function names.",
  "dependencies": {
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "@types/winston": "^2.4.4",
    "bun-types": "^1.3.4",
    "cypress": "^15.7.1",
    "esbuild": "^0.27.1",
    "ts-standard": "^12.0.2",
    "typescript": "^5.3.2"
  },
  "license": "Apache-2.0",
  "main": "index.tsx",
  "name": "logger",
  "packageManager": "yarn@4.0.0",
  "scripts": {
    "build": "tsc && bun build ./src/index.ts --outfile=sqwerl-configuration.js --outdir=dist"
  },
  "standard": {
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "typescript"
    ]
  },
  "ts-standard": {
    "project": "./tsconfig.json"
  },
  "version": "0.0.6"
}
