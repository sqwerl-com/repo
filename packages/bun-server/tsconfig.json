{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "downlevelIteration": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "module": "esnext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "outDir": "dist",
    "references": [{
      "path": "../logger"
    }, {
      "path": "../configuration"
    }],
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "types": [
      "bun-types" // add Bun global
    ]
  }
}
