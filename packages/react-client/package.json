{
  "allLocales": [
    "en"
  ],
  "author": "Sqwerl Technologies, LLC",
  "babel": {
    "presets": [
      "react-app"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "dependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^25.0.3",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-window": "^1.8.8",
    "@types/react-window-infinite-loader": "^1.0.9",
    "@visx/axis": "^4.0.0-alpha",
    "@visx/grid": "^4.0.0-alpha",
    "@visx/group": "^4.0.0-alpha",
    "@visx/scale": "^4.0.0-alpha",
    "@visx/shape": "^4.0.0-alpha",
    "@visx/xychart": "^4.0.0-alpha",
    "d3-time": "^3.1.0",
    "date-fns": "^4.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-feather": "^2.0.10",
    "react-intl": "^8.0.9",
    "react-router-dom": "^7.11.0",
    "react-transition-group": "^4.4.5",
    "react-window": "^1.8.11",
    "react-window-infinite-loader": "^1.0.9"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.5",
    "@babel/eslint-parser": "^7.28.5",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/plugin-transform-private-property-in-object": "^7.27.1",
    "@babel/preset-react": "^7.27.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.2",
    "@formatjs/ts-transformer": "^4.0.7",
    "@react-spring/web": "^10.0.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react-transition-group": "^4.4.12",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/coverage-istanbul": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "babel-jest": "^30.1.2",
    "babel-plugin-formatjs": "^11.0.8",
    "babel-plugin-react-intl": "^8.2.25",
    "baseline-browser-mapping": "^2.9.11",
    "eslint": "^9.39.2",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "http-proxy-middleware": "^3.0.3",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "jest-axe": "^10.0.0",
    "jest-junit": "^16.0.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.7.4",
    "react-intl-translations-manager": "^5.0.3",
    "rollup": "^4.54.0",
    "sass": "^1.97.1",
    "source-map-explorer": "^2.5.3",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-standard": "^12.0.2",
    "typedoc": "^0.28.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.51.0",
    "vite": "7.3.0",
    "vite-test-utils": "^0.6.0",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16",
    "vitest-fetch-mock": "^0.4.3"
  },
  "homepage": "https://www.sqwerl.com",
  "jest-junit": {
    "ancestorSeparator": ">",
    "classNameTemplate": "{classname} - {title}",
    "output": "coverage/junit.xml",
    "suiteName": "jest tests",
    "titleTemplate": "{classname} - {title}",
    "usePathForSuiteName": "true"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "standard",
      "git add"
    ]
  },
  "name": "react-client",
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.54.0",
    "@rollup/rollup-darwin-x64": "^4.54.0"
  },
  "plugins": [
    [
      "react-intl",
      {
        "messagesDir": "src/translations/messages/",
        "enforceDescriptions": false
      }
    ]
  ],
  "private": true,
  "proxy": "http://localhost:6719/",
  "scripts": {
    "build": "bun run build-skip-lint",
    "build-css": "bunx sass src/",
    "build-doc": "typedoc --entryPointStrategy Expand src --exclude **/*.test.* --out build/docs",
    "build-skip-lint": "tsc && bun build ./src/index.tsx --outfile=react-client.js --outdir=dist",
    "build-translations": "rm -f ./src/translations/locales/en.json && node ./scripts/translation-runner.cjs",
    "coverage": "vitest --coverage --dir src --reporter html",
    "dev": "vite",
    "lint": "bun run lint-code && bun run lint-styles",
    "lint-code": "bunx ts-standard src/**/*.tsx",
    "lint-eslint": "bunx eslint src/**/*.ts[x]",
    "lint-styles": "bunx stylelint **/*.scss",
    "preview": "vite preview --port 3333",
    "start-webserver": "nginx -p . -c config/nginx.conf",
    "test": "vitest --dir src",
    "watch-css": "sass src/ --watch"
  },
  "standard": {
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "typescript"
    ]
  },
  "ts-standard": {
    "ignore": [
      "dist",
      "src/**/*.js"
    ],
    "project": "./tsconfig.json"
  },
  "type": "module",
  "version": "0.2.0"
}
