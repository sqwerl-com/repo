{
  "allLocales": [
    "en"
  ],
  "author": "Sqwerl Technologies, LLC",
  "babel": {
    "presets": [
      "react-app"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "dependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^22.10.1",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-window": "^1.8.8",
    "@types/react-window-infinite-loader": "^1.0.9",
    "@visx/axis": "^3.12.0",
    "@visx/grid": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "@visx/xychart": "^3.12.0",
    "d3-time": "^3.1.0",
    "date-fns": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-feather": "^2.0.10",
    "react-intl": "^7.0.4",
    "react-router-dom": "^7.0.2",
    "react-transition-group": "^4.4.5",
    "react-window": "^1.8.10",
    "react-window-infinite-loader": "^1.0.9"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.25.9",
    "@babel/plugin-transform-modules-commonjs": "^7.26.3",
    "@babel/plugin-transform-private-property-in-object": "^7.25.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@formatjs/ts-transformer": "^3.13.26",
    "@react-spring/web": "^9.7.5",
    "@swc/core": "^1.10.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/react-test-renderer": "^19.0.0",
    "@types/react-transition-group": "^4.4.11",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "@vitest/coverage-istanbul": "^2.1.8",
    "@vitest/coverage-v8": "2.1.8",
    "@vitest/ui": "^2.1.8",
    "babel-jest": "^29.7.0",
    "babel-plugin-formatjs": "^10.5.29",
    "babel-plugin-react-intl": "^8.2.25",
    "cypress": "^13.16.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.16.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "http-proxy-middleware": "^3.0.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-axe": "^9.0.0",
    "jest-junit": "^16.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "react-intl-translations-manager": "^5.0.3",
    "react-test-renderer": "^19.0.0",
    "rollup": "^4.28.1",
    "sass": "^1.82.0",
    "source-map-explorer": "^2.5.3",
    "stylelint": "^16.11.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-standard": "^12.0.2",
    "typedoc": "^0.27.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-test-utils": "^0.6.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8",
    "vitest-fetch-mock": "^0.4.2"
  },
  "homepage": "https://www.sqwerl.com",
  "jest-junit": {
    "ancestorSeparator": ">",
    "classNameTemplate": "{classname} - {title}",
    "output": "coverage/junit.xml",
    "suiteName": "jest tests",
    "titleTemplate": "{classname} - {title}",
    "usePathForSuiteName": "true"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "standard",
      "git add"
    ]
  },
  "name": "react-client",
  "plugins": [
    [
      "react-intl",
      {
        "messagesDir": "src/translations/messages/",
        "enforceDescriptions": false
      }
    ]
  ],
  "private": true,
  "proxy": "http://localhost:6719/",
  "scripts": {
    "analyze-bundle": "source-map-explorer build/static/js/main.*",
    "build": "bun run build-skip-lint && bun run lint",
    "build-css": "bunx sass src/",
    "build-doc": "typedoc --entryPointStrategy expand src --exclude **/*.test.tsx --out build/docs",
    "build-skip-lint": "tsc && bun build ./src/index.tsx --outfile=react-client.js --outdir=dist",
    "build-translations": "rm -f ./src/translations/locales/en.json && node ./scripts/translation-runner.cjs",
    "dev": "vite",
    "lint": "bun run lint-code && bun run lint-styles",
    "lint-code": "bunx ts-standard src/**/*.tsx",
    "lint-eslint": "bunx eslint src",
    "lint-styles": "bunx stylelint **/*.scss",
    "preview": "vite preview",
    "start-webserver": "nginx -p . -c config/nginx.conf",
    "test-jest": "jest --env=jsdom --coverage src/**/*.test.ts? --transformIgnorePatterns \"node_modules/(?!d3|d3-array|d3-time|internmap|delaunator|robust-predicates)/\"",
    "test": "vitest --coverage --dir src --environment jsdom",
    "watch-css": "sass src/ --watch"
  },
  "standard": {
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "typescript"
    ]
  },
  "ts-standard": {
    "project": "./tsconfig.json"
  },
  "type": "module",
  "version": "0.2.0"
}
