{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "downlevelIteration": true,
    "forceConsistentCasingInFileNames": true,
    "includes": [
      "src/**/*.ts[x]",
      "src/**/*.test.ts[x]"
    ],
    "jsx": "preserve",
    "lib": ["ESNext"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "target": "esnext",
    "types": [
      "bun-types" // add Bun global
    ]
  }
}